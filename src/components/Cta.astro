---
import AppStoreBadge from './AppStoreBadge.astro';
import PipBunny from './PipBunny.astro';
---
<section class="cta">
  <div class="wrap cta__inner pixel-card">
    <div class="cta__copy">
      <h2 class="cta__title">Ready to farm with Pip?</h2>
      <p class="cta__lead">Download Puzzle Farming: Harvest Loop on the App Store. iPhone and iPad, landscape play.</p>
      <AppStoreBadge />
    </div>
    <div class="cta__art" aria-hidden="true">
      <PipBunny size={80} />
      <img src="/assets/icon-carrot.png" alt="" class="cta__carrot cta__carrot--1" width="56" height="56" />
      <img src="/assets/icon-carrot.png" alt="" class="cta__carrot cta__carrot--2" width="44" height="44" />
    </div>
  </div>
</section>

<style>
  .cta { padding: 80px 0 0; position: relative; z-index: 1; }
  .cta__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding: 40px 36px;
    background: linear-gradient(135deg, var(--hl-cream), var(--hl-mint-dark));
    overflow: hidden;
  }
  .cta__title { font-size: clamp(14px, 2vw, 18px); line-height: 1.5; }
  .cta__lead {
    font-size: 16px; line-height: 1.6; color: var(--hl-ink-muted);
    margin: 12px 0 20px; max-width: 420px;
  }
  .cta__art {
    position: relative;
    width: 140px; height: 120px;
    flex-shrink: 0;
  }
  .cta__art :global(svg) {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 4px 0 rgba(41, 64, 71, 0.2));
  }
  .cta__carrot {
    position: absolute;
    image-rendering: pixelated;
    filter: drop-shadow(0 3px 0 rgba(41, 64, 71, 0.2));
    animation: bob 3s ease-in-out infinite;
  }
  .cta__carrot--1 { right: 0; bottom: 0; }
  .cta__carrot--2 { left: 0; top: 0; animation-delay: 1.5s; transform: scaleX(-1); }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .cta__carrot--2 {
    animation-name: bob-flip;
  }
  @keyframes bob-flip {
    0%, 100% { transform: scaleX(-1) translateY(0); }
    50% { transform: scaleX(-1) translateY(-6px); }
  }
  @media (max-width: 640px) {
    .cta__inner { flex-direction: column; text-align: center; }
    .cta__art { order: -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta__carrot { animation: none; }
  }
</style>
