---
import { site } from '../data/site';
---
<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__tag">{site.tagline}. Made with care by {site.studio}.</p>
    </div>
    <nav class="footer__col" aria-label="App">
      <p class="footer__label">APP</p>
      <a href={site.appStore}>Download for iOS</a>
      <a href="/#features">Features</a>
      <a href="/#gameplay">Gameplay</a>
    </nav>
    <nav class="footer__col" aria-label="Legal">
      <p class="footer__label">LEGAL</p>
      <a href="/terms">Terms of Service</a>
      <a href="/privacy">Privacy Policy</a>
    </nav>
    <nav class="footer__col" aria-label="Contact">
      <p class="footer__label">CONTACT</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </nav>
  </div>
  <div class="wrap footer__legal">© 2026 {site.studioLegal} · All rights reserved</div>
</footer>

<style>
  .footer {
    margin-top: 80px;
    border-top: 3px solid var(--hl-ink);
    background: var(--hl-cream);
  }
  .footer__inner {
    display: flex; gap: 34px; flex-wrap: wrap; align-items: flex-start;
    padding-top: 38px; padding-bottom: 30px;
  }
  .footer__brand { flex: 1; min-width: 240px; }
  .footer__name {
    font-family: var(--hl-font-pixel);
    font-size: 10px;
    margin: 0;
  }
  .footer__tag {
    font-size: 13.5px; line-height: 1.6; color: var(--hl-ink-muted);
    margin: 10px 0 0; max-width: 300px;
  }
  .footer__col { display: flex; flex-direction: column; gap: 9px; min-width: 140px; }
  .footer__col a { font-size: 13.5px; color: var(--hl-ink-muted); font-weight: 600; }
  .footer__col a:hover { color: var(--hl-teal); }
  .footer__label {
    font-family: var(--hl-font-pixel);
    font-size: 8px; color: var(--hl-teal); margin: 0;
  }
  .footer__legal {
    font-size: 12.5px; color: var(--hl-ink-muted);
    padding-bottom: 34px;
  }
</style>
