---
import '../styles/global.css';
import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.storeName,
  operatingSystem: 'iOS',
  applicationCategory: 'GameApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: site.description,
  url: site.url,
  image: new URL('/og.png', site.url).toString(),
};

const reveal = [
  '.hero__copy > *', '.hero__visual',
  '.strip__track', '.features__head', '.features__grid > .card',
  '.how__head', '.how__steps > li',
  '.screens__head', '.screens__item',
  '.blocks__head', '.blocks__grid > *',
  '.quotes__inner > *',
  '.faq > *', '.about > *', '.cta',
  '.legal > *',
].join(',');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon/app-icon.png" />
    <meta name="theme-color" content="#9EE6D6" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', site.url).toString()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style is:global set:html={`
      .hl-motion :is(${reveal}) { opacity: 0; transform: translateY(18px); }
      .hl-motion :is(${reveal}).is-in {
        opacity: 1; transform: none;
        transition: opacity .55s ease, transform .55s cubic-bezier(.22,.7,.15,1);
        transition-delay: var(--hl-delay, 0ms);
      }
    `}></style>
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('hl-motion');
      }
    </script>
  </head>
  <body>
    <Nav />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ reveal }}>
      if (document.documentElement.classList.contains('hl-motion')) {
        const io = new IntersectionObserver((entries, obs) => {
          entries.filter((e) => e.isIntersecting).forEach((e, i) => {
            e.target.style.setProperty('--hl-delay', i * 65 + 'ms');
            e.target.classList.add('is-in');
            obs.unobserve(e.target);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll(reveal).forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
